+/// Routes all base node requests through a proxy, including those of wallets already running (the
+/// wallet creates a new HTTP client for each request).
+///
+/// ## Arguments
+/// `proxy` - A proxy URL such as `socks5h://127.0.0.1:9150` (Tor; `socks5h` resolves names through the proxy),
+/// or null to connect directly. If the proxy can't be reached, requests fail rather than bypassing it.
+/// `error_out` - Pointer to an int which will be modified to an error code should one occur, may not be null.
+///
+/// ## Returns
+/// `bool` - true if the setting was applied.
+///
+/// # Safety
+/// `proxy` must be null or a valid nul-terminated string.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn wallet_set_http_proxy(proxy: *const c_char, error_out: *mut c_int) -> bool {
+    unsafe {
+        if error_out.is_null() {
+            return false;
+        }
+        *error_out = 0;
+        let proxy = if proxy.is_null() {
+            None
+        } else {
+            match CStr::from_ptr(proxy).to_str() {
+                Ok(s) => Some(s.to_owned()),
+                Err(_) => {
+                    *error_out = LibWalletError::from(InterfaceError::PointerError("proxy".to_string())).code;
+                    return false;
+                },
+            }
+        };
+        match minotari_node_wallet_client::http::set_http_proxy(proxy) {
+            Ok(()) => true,
+            Err(e) => {
+                error!(target: LOG_TARGET, "Invalid proxy: {e}");
+                *error_out = LibWalletError::from(InterfaceError::InvalidArgument("proxy".to_string())).code;
+                false
+            },
+        }
+    }
+}
