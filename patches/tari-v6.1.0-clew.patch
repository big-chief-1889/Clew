+/// Proxy for every base node request, e.g. `socks5h://127.0.0.1:9150` for Tor, set by the host app.
+/// `None` until the host app sets a route: requests go to a dead proxy until then, so nothing connects
+/// directly by accident. `Some(None)` is a direct connection the host app chose.
+static HTTP_PROXY: std::sync::RwLock<Option<Option<String>>> = std::sync::RwLock::new(None);
+
+/// Where requests go when there is no usable route: a closed local port.
+const DEAD_PROXY: &str = "socks5h://127.0.0.1:1";
+
+/// Routes base node requests through `proxy` (or directly when `None`). Only `socks5h://` proxies are
+/// accepted, so DNS lookups go through the proxy too. The wallet creates a client per request, so this
+/// applies to running wallets from their next request. With a proxy set, requests that can't reach it
+/// fail rather than connecting directly.
+pub fn set_http_proxy(proxy: Option<String>) -> Result<(), anyhow::Error> {
+    if let Some(proxy) = &proxy {
+        if !proxy.starts_with("socks5h://") {
+            return Err(anyhow!("only socks5h:// proxies are supported"));
+        }
+        reqwest::Proxy::all(proxy)?;
+    }
+    *HTTP_PROXY.write().map_err(|_| anyhow!("proxy setting lock poisoned"))? = Some(proxy);
+    Ok(())
+}
