diff --git a/clients/tari_indexer_client/src/proxy.rs b/clients/tari_indexer_client/src/proxy.rs
new file mode 100644
index 0000000..a225ea1
--- /dev/null
+++ b/clients/tari_indexer_client/src/proxy.rs
@@ -0,0 +1,40 @@
+// Copyright 2026 The Tari Project
+// SPDX-License-Identifier: BSD-3-Clause
+
+//! A process-wide proxy for indexer connections, so a host app can route them through Tor.
+
+use std::{sync::RwLock, time::Duration};
+
+/// Proxy for indexer clients, e.g. `socks5h://127.0.0.1:9150` for Tor. `None` connects directly.
+static HTTP_PROXY: RwLock<Option<String>> = RwLock::new(None);
+
+/// Routes indexer clients created after this call through `proxy` (or directly when `None`).
+/// Clients keep the route they were created with, so reconnect after changing it. With a proxy
+/// set, requests that can't reach it fail rather than connecting directly.
+pub fn set_http_proxy(proxy: Option<String>) -> Result<(), reqwest::Error> {
+    if let Some(proxy) = &proxy {
+        reqwest::Proxy::all(proxy)?;
+    }
+    *HTTP_PROXY.write().unwrap_or_else(|e| e.into_inner()) = proxy;
+    Ok(())
+}
+
+/// Connecting through a proxy includes the proxy's own work (for Tor, building a circuit), so it
+/// gets longer than a direct connection would.
+const PROXY_CONNECT_TIMEOUT: Duration = Duration::from_secs(30);
+
+/// Applies the configured proxy to a client builder. If the setting can't be read, uses a dead
+/// proxy: fail closed rather than connect directly. Call it after any `connect_timeout`.
+pub(crate) fn apply(builder: reqwest::ClientBuilder) -> reqwest::ClientBuilder {
+    let proxy = HTTP_PROXY
+        .read()
+        .map(|p| p.clone())
+        .unwrap_or_else(|_| Some("socks5h://127.0.0.1:1".to_string()));
+    match proxy {
+        // Validated in set_http_proxy; an explicit proxy also turns off system proxy detection.
+        Some(proxy) => builder
+            .proxy(reqwest::Proxy::all(proxy).expect("validated in set_http_proxy"))
+            .connect_timeout(PROXY_CONNECT_TIMEOUT),
+        None => builder,
+    }
+}
